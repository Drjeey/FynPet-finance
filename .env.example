# Copy to .env for local development with `netlify dev` (never commit .env).
# In production, set these in Netlify: Site configuration → Environment variables.

# Anthropic API key — mark as "secret" in Netlify, scope: Functions only.
ANTHROPIC_API_KEY=

# Supabase project (Settings → API). The anon key is public by design; RLS protects data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=60
